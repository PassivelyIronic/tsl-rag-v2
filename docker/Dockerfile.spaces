# Obraz pod Hugging Face Spaces (SDK: docker).
#
# Różni się od docker/Dockerfile tym, że uruchamia OBIE części w jednym
# kontenerze: FastAPI na wewnętrznym porcie 8000 i Streamlit na 7860, który
# Spaces wystawia na zewnątrz. To ustępstwo wobec platformy, nie zmiana
# architektury — Spaces daje jeden kontener i jeden port. W klastrze K8s
# (Faza 6) oba serwisy zostają rozdzielone, dlatego kod się nie zmienia,
# a UI dalej rozmawia z API po HTTP.
#
# Bazy danych TU NIE MA. Postgres z pgvector musi być zewnętrzny i podany
# w sekrecie POSTGRES_DSN — Spaces nie utrzyma drugiego procesu ze stanem,
# a dysk kontenera jest ulotny.

FROM python:3.11-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ ./src/
COPY README.md ./
RUN uv sync --frozen --no-dev


FROM python:3.11-slim AS runtime

# UID 1000 — Hugging Face Spaces uruchamia kontener jako ten użytkownik
# i tylko jego katalog domowy jest zapisywalny. Przy innym UID pobieranie
# wag modelu embeddingów kończy się błędem uprawnień.
RUN useradd --create-home --uid 1000 user

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/user \
    HF_HOME=/home/user/.cache/huggingface \
    # UI rozmawia z API po pętli zwrotnej wewnątrz tego samego kontenera.
    API_BASE_URL=http://localhost:8000 \
    # Dysk Spaces jest ulotny, więc wagi (~1.1 GB) pobierają się przy każdym
    # zimnym starcie. Rozgrzewka w warmup() sprawia, że płaci za to start
    # kontenera, a nie pierwsze pytanie użytkownika.
    EMBEDDING_PROVIDER=local

WORKDIR /app

COPY --from=builder --chown=user:user /app/.venv /app/.venv
COPY --from=builder --chown=user:user /app/src /app/src
COPY --chown=user:user ui.py ./
COPY --chown=user:user docker/spaces-start.sh ./
RUN chmod +x spaces-start.sh

USER user
EXPOSE 7860

CMD ["./spaces-start.sh"]
