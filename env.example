# =============================================================================
# TSL-RAG v2 — Konfiguracja środowiska
#
# Skopiuj do .env i uzupełnij klucze:  cp env.example .env
#
# UWAGA: każda zmienna tutaj MUSI mieć odpowiednik w src/tsl_rag/core/settings.py.
# Settings ma extra="forbid", więc zmienna bez odpowiednika wywala start
# komunikatem "Extra inputs are not permitted" (CLAUDE.md §8).
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Providery: rozdzielone dla embeddingów i dla generacji/chatu ---
# To DWA NIEZALEŻNE przełączniki (CLAUDE.md §3). Mieszanie ich to najczęstszy
# błąd w tym repo — ustawienie OPENROUTER_CHAT_MODEL przy CHAT_PROVIDER=ollama
# nie robi nic.
# EMBEDDING_PROVIDER: "local" (sentence-transformers w procesie, CPU) | "ollama" | "openai"
# CHAT_PROVIDER:      "ollama" (lokalny) | "openai" | "openrouter"
#
# UWAGA: zmiana EMBEDDING_PROVIDER albo modelu embeddingów WYMAGA ponownego
# ingestu całego korpusu. Zapytanie policzone jednym modelem, porównywane
# z dokumentami policzonymi innym, daje bezsensowne wyniki i NIE zgłasza błędu.
# Retriever sprawdza to przy starcie i przerywa z komunikatem.
EMBEDDING_PROVIDER=local
CHAT_PROVIDER=ollama

# --- Lokalne embeddingi (EMBEDDING_PROVIDER=local) ---
# Odcina system od Ollamy: brak rate limitu, brak klucza API w runtime,
# brak ryzyka, że model zniknie z darmowej puli. Wagi pobierają się raz,
# przy pierwszym użyciu (~1.1 GB dla e5-base).
#
# Prefiksy: modele z rodziny E5 wymagają "query: " i "passage: ". Pominięcie
# ich nie powoduje błędu, tylko obniża jakość — niewidocznie. bge-m3 prefiksów
# nie używa, więc przy przełączeniu na niego USTAW OBA NA PUSTE, inaczej
# porównujesz model z prefiksami do modelu bez nich.
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
LOCAL_EMBED_DIMENSIONS=768
LOCAL_EMBED_QUERY_PREFIX="query: "
LOCAL_EMBED_PASSAGE_PREFIX="passage: "
LOCAL_EMBED_BATCH_SIZE=16

# --- Ollama (lokalny, domyślny) ---
# Przed startem uruchom:
#   ollama pull mistral:7b-instruct-q4_K_M
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=mistral:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768

# --- OpenAI (opcjonalnie, EMBEDDING_PROVIDER lub CHAT_PROVIDER = openai) ---
# Płatne od pierwszego tokena. W tym projekcie przewidziane wyłącznie jako
# model referencyjny w evalu (PLAN.md Faza 1), nie jako runtime.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# --- OpenRouter (opcjonalnie, CHAT_PROVIDER=openrouter) ---
# Klucz: https://openrouter.ai/keys (bez karty na start)
# Poniższy slug to JEDYNY model zweryfikowany empirycznie w tym projekcie
# (evals/results/model_comparison.json). Darmowe modele znikają z puli bez
# ostrzeżenia — nowy slug kopiuj z zakładki API modelu, nie z katalogu:
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-nano-9b-v2:free

# --- Gemini (opcjonalnie, wyłącznie pod ewaluację — LLM-as-a-judge) ---
GEMINI_API_KEY=

# --- Parametry generacji ---
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# Sterowanie rozumowaniem modeli typu "reasoning". Puste = parametr nie jest
# wysyłany. Nie każdy model obsługuje ten parametr — Gemma odpowiada 400.
#
# UWAGA: na nemotron-nano-9b-v2 ten parametr NIE DZIAŁA (zmierzone 2026-07-27:
# tokeny rozumowania 381/298 bez parametru wobec 436/453 przy "none"), mimo że
# OpenRouter wykazuje dla tego modelu obsługę `reasoning`. Użyj LLM_SYSTEM_PREFIX.
LLM_REASONING_EFFORT=

# Tekst doklejany PRZED system prompt. Puste = nic nie doklejamy.
# Dla nemotron-nano-9b-v2 ustaw `/no_think` — zmierzone: tokeny rozumowania
# spadają z ~350-450 do 0, całe wyjście z ~446 tokenów do 86, a puste odpowiedzi
# przestają mieć skąd się brać. Wysłany do modelu, który tego tokenu nie zna,
# zostanie w promptcie jako śmieć — dlatego jest konfiguracją, nie domyślną.
LLM_SYSTEM_PREFIX=


# --- PostgreSQL + pgvector ---
# Port 5433, nie 5432 — docker-compose.yml mapuje 5433:5432, żeby nie kolidować
# z kontenerem poprzedniej wersji projektu (CLAUDE.md §8).
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/tsl_rag

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_N=5
# Wagi ważonego RRF, muszą sumować się do 1.0 (walidator w Settings).
# 0.5/0.5 = obie listy równoważne = obecny baseline. Zmiana proporcji zmienia
# ranking, więc wymaga przebiegu evalu przed i po (CLAUDE.md §9).
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

# --- Reranker: WYŁĄCZONY na podstawie pomiaru (PLAN.md Faza 1) ---
# Retrieval bez rerankingu: recall@5 0.938 w 0.1 s.
# Najlepszy zmierzony reranker: recall@5 0.969 w 43.4 s. Nie warte tego czasu.
# Model i okno zostawione na najlepszym wariancie, żeby włączenie z powrotem
# było jedną zmianą RERANKER_ENABLED=true.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Generation: limit kontekstu w ZNAKACH, nie tokenach ---
MAX_CONTEXT_CHARS=12000

# --- Ingestion: parametry chunkera (zmiana wymaga ponownego ingestu) ---
CHUNKER_MAX_TOKENS=450
CHUNKER_MIN_TOKENS=60
CHUNKER_OVERLAP_TOKENS=60
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Ile tokenów pary (zapytanie, chunk) widzi cross-encoder. Chunki taryfikatorów
# to duże tabele — przy 512 właściwy wiersz bywa poza obcięciem.
RERANKER_MAX_LENGTH=2048
# Wyłączaj wyłącznie na podstawie pomiaru z run_retrieval_evals (CLAUDE.md §5.5)
RERANKER_ENABLED=false
